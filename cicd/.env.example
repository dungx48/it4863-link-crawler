# Copy to cicd/.env and use --env-file cicd/.env.
# This public template contains examples only; keep real credentials in .env.
# Connect to the PostgreSQL instance already running on your server.
# host.docker.internal reaches the host from the crawler container.
# For a remote database, use its private hostname/IP instead.
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=crawler
PGUSER=crawler
# Required: fill in your own database password.
PGPASSWORD=
PGSSLMODE=prefer
HUST_ALLOW_SUBDOMAINS=1
HUST_UA=HustIRBot/1.0 (+academic information-retrieval coursework; contact local)

# Required only for crawler-api: private ASCII token, at least 32 characters.
# CRAWLER_API_TOKEN=
CRAWLER_API_PORT=8000
CRAWLER_MAX_PAGES=2500
CRAWLER_DEPTH_LIMIT=4
CRAWLER_TIMEOUT_SECONDS=21600
